{
	"name": "standard-log",
	"version": "13.0.1",
	"description": "The standard log library",
	"homepage": "https://github.com/cyberuni/standard-log/tree/main/packages/log",
	"bugs": {
		"url": "https://github.com/cyberuni/standard-log/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/standard-log.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./esm/index.d.ts",
				"default": "./esm/index.js"
			},
			"require": {
				"types": "./cjs/index.d.ts",
				"default": "./cjs/index.js"
			}
		},
		"./testing": {
			"import": {
				"types": "./esm/testing/index.d.ts",
				"default": "./esm/testing/index.js"
			},
			"require": {
				"types": "./cjs/testing/index.d.ts",
				"default": "./cjs/testing/index.js"
			}
		}
	},
	"main": "./cjs/index.js",
	"module": "./esm/index.js",
	"browser": {
		"./cjs/platform.js": "./cjs/platform.browser.js",
		"./esm/platform.js": "./esm/platform.browser.js",
		"./tslib/platform.js": "./tslib/platform.browser.js",
		"./ts/platform.ts": "./ts/platform.browser.ts"
	},
	"types": "./cjs/index.d.ts",
	"files": [
		"cjs",
		"dist",
		"esm",
		"testing",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system}.*",
		"!**/test_utils.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf cjs coverage dist esm --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "pnpm clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"w": "vitest"
	},
	"dependencies": {
		"@just-func/types": "^0.5.0",
		"iso-error": "^6.0.0",
		"ms": "^2.1.3",
		"type-plus": "^7.0.0"
	},
	"devDependencies": {
		"@repobuddy/vitest": "^2.1.1",
		"@types/ms": "^2.0.0",
		"@types/node": "^24.0.0",
		"@types/ramda": "^0.32.0",
		"assertron": "^11.0.0",
		"depcheck": "^1.4.3",
		"dirname-filename-esm": "^1.1.1",
		"ramda": "^0.32.0",
		"rimraf": "^6.0.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.0"
	}
}
