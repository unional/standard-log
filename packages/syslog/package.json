{
	"name": "standard-log-syslog",
	"version": "13.0.1",
	"description": "syslog plugin for `standard-log`",
	"homepage": "https://github.com/cyberuni/standard-log/tree/main/packages/syslog",
	"bugs": {
		"url": "https://github.com/cyberuni/standard-log/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/standard-log.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"import": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		},
		"require": {
			"types": "./cjs/index.d.ts",
			"default": "./cjs/index.js"
		}
	},
	"main": "./cjs/index.js",
	"module": "./esm/index.js",
	"types": "./cjs/index.d.ts",
	"files": [
		"dist",
		"cjs",
		"esm",
		"ts",
		"!**/*.spec.*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rimraf cjs coverage dist esm --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "pnpm clean && rimraf node_modules",
		"test": "vitest run",
		"typecheck": "tsc",
		"w": "vitest"
	},
	"devDependencies": {
		"@repobuddy/vitest": "^2.1.1",
		"@types/node": "^24.0.0",
		"depcheck": "^1.4.3",
		"rimraf": "^6.0.0",
		"standard-log": "workspace:*",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.0"
	},
	"peerDependencies": {
		"standard-log": ">=11.0.1"
	}
}
