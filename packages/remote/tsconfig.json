{
	"extends": "../../config/tsconfig.base.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		// tsdown does not typecheck — `pnpm typecheck` is what does, so this config emits nothing.
		"noEmit": true,
		"rootDir": "ts",
		// TypeScript 7 no longer auto-includes every `@types/*` package it finds.
		"types": ["node", "vitest/globals"]
	},
	"include": ["ts", "typings"]
}
