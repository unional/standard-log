{
	"name": "standard-log-remote",
	"version": "13.0.0",
	"description": "remote logging for `standard-log`",
	"homepage": "https://github.com/cyberuni/standard-log/tree/main/packages/remote",
	"bugs": {
		"url": "https://github.com/cyberuni/standard-log/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cyberuni/standard-log.git",
		"directory": "packages/remote"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong",
		"email": "homawong@gmail.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		"import": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		},
		"require": {
			"types": "./cjs/index.d.ts",
			"default": "./cjs/index.js"
		}
	},
	"main": "./cjs/index.js",
	"module": "./esm/index.js",
	"types": "./cjs/index.d.ts",
	"files": [
		"cjs",
		"esm",
		"ts",
		"!**/*.spec.*"
	],
	"scripts": {
		"build": "run-p build:cjs build:esm",
		"build:clean": "rimraf *.tsbuildinfo",
		"build:cjs": "tsc -p ./tsconfig.cjs.json && ncp package.cjs.json cjs/package.json",
		"build:esm": "tsc",
		"clean": "rimraf cjs coverage dist esm lib libm tslib --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"depcheck": "depcheck",
		"nuke": "run-s clean nuke:local",
		"nuke:local": "rimraf node_modules",
		"size": "size-limit",
		"test": "vitest run",
		"verify": "npm-run-all -p build depcheck coverage -p size",
		"w": "vitest"
	},
	"dependencies": {
		"cross-fetch": "^4.0.0"
	},
	"devDependencies": {
		"@repobuddy/vitest": "^2.1.1",
		"@size-limit/preset-small-lib": "^13.0.0",
		"@types/node": "^24.0.0",
		"assertron": "^11.0.0",
		"depcheck": "^1.4.3",
		"ncp": "^2.0.0",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.0",
		"size-limit": "^13.0.0",
		"standard-log": "workspace:^",
		"typescript": "^5.0.0",
		"vitest": "^4.1.0"
	},
	"peerDependencies": {
		"standard-log": ">=11.0.1"
	},
	"size-limit": [
		{
			"path": "./cjs/index.js",
			"limit": "10 kB"
		},
		{
			"path": "./esm/index.js",
			"limit": "10 kB"
		}
	]
}
