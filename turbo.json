{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["cjs/**", "dist/**", "esm/**"]
		},
		"clean": { "cache": false },
		"coverage": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"depcheck": { "dependsOn": ["^build"] },
		"nuke": { "cache": false },
		"test": { "dependsOn": ["^build"] },
		"typecheck": { "dependsOn": ["^build"] }
	}
}
