{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["cjs/**", "dist/**", "esm/**", "tslib/**"]
		},
		"build-doc": {
			"outputs": ["storybook-static/**", "docs/**"]
		},
		"check": {},
		"clean": { "cache": false },
		"coverage": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"cov": {},
		"depcheck": { "dependsOn": ["^build"] },
		"nuke": { "cache": false },
		"sb": {},
		"size": { "dependsOn": ["build"] },
		"test": { "dependsOn": ["^build"] }
	}
}
