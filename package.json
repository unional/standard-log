{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "turbo run clean",
		"color": "pnpm --filter=standard-log-color",
		"cov": "vitest run --coverage",
		"coverage": "turbo run coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"dev": "turbo run dev --parallel",
		"log": "pnpm --filter=standard-log",
		"nuke": "turbo run nuke && pnpm nuke:local",
		"nuke:local": "rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"remote": "pnpm --filter=standard-log-remote",
		"syslog": "pnpm --filter=standard-log-syslog",
		"test": "turbo run test",
		"verify": "pnpm check && turbo run build typecheck coverage depcheck",
		"version": "changeset version",
		"w": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@repobuddy/biome": "^2.3.1",
		"@repobuddy/vitest": "^2.1.1",
		"@vitest/coverage-v8": "^4.0.18",
		"husky": "^9.0.0",
		"rimraf": "~6.1.0",
		"tsdown": "^0.22.14",
		"turbo": "^2.9.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.0"
	},
	"packageManager": "pnpm@11.25.0",
	"overrides": {
		"path-to-regexp@<0.1.13": ">=0.1.13"
	}
}
