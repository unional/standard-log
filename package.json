{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"build:doc": "turbo run build-doc",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "turbo run clean",
		"color": "pnpm --filter=standard-log-color",
		"coverage": "turbo run coverage",
		"cov": "vitest run --coverage",
		"cs": "changeset",
		"depcheck": "turbo run depcheck",
		"dev": "turbo run dev --parallel",
		"docs": "pnpm --filter=@standard-log/solid-example",
		"log": "pnpm --filter=standard-log",
		"nuke": "turbo run nuke && pnpm nuke:local",
		"nuke:local": "rimraf node_modules",
		"postinstall": "husky install",
		"prepack": "pinst --disable",
		"postpack": "pinst --enable",
		"prepare": "husky install",
		"release": "changeset publish",
		"remote": "pnpm --filter=standard-log-remote",
		"sb": "turbo run sb",
		"size": "turbo run size",
		"solid-example": "pnpm --filter=@standard-log/solid-example",
		"syslog": "pnpm --filter=standard-log-syslog",
		"test": "turbo run test",
		"verify": "turbo run check build cov depcheck size",
		"version": "changeset version",
		"w": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@changesets/cli": "^2.25.0",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@repobuddy/biome": "^2.3.1",
		"@repobuddy/vitest": "^2.1.1",
		"@vitest/coverage-v8": "^4.0.18",
		"husky": "^9.0.0",
		"pinst": "^3.0.0",
		"rimraf": "~6.1.0",
		"turbo": "^2.8.3",
		"typescript": "^5.0.0",
		"vitest": "^4.0.18"
	},
